# Renomeie para .env e preencha com valores reais antes de rodar

DATABASE_URL="postgresql://usuario:senha@host-do-postgres:5432/oliveiras?schema=public&sslmode=require"

# Segredo usado para assinar os tokens JWT — gere um valor aleatório forte em produção
JWT_SECRET="gere-um-segredo-forte-e-unico-na-vercel"

# Tempo de expiração do token de acesso
JWT_EXPIRES_IN="8h"

PORT=3333

# Em produção, informe o domínio do frontend Vercel. Separe múltiplos domínios por vírgula.
CORS_ORIGIN="https://oliveiras-frontend.vercel.app"
