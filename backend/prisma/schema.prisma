// Schema do banco de dados — Sistema Casa de Carnes Oliveiras
// Fase 1 implementa: Usuario (auth + permissões)
// Demais modelos já modelados aqui para as próximas fases (clientes, produtos, pedidos...)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PapelUsuario {
  FUNCIONARIO
  ADMINISTRATIVO
}

enum StatusRegistro {
  ATIVO
  INATIVO
}

model Usuario {
  id           String         @id @default(uuid())
  nome         String
  login        String         @unique
  senhaHash    String         @map("senha_hash")
  email       String?
  // Recebe por e-mail, todo dia, o resumo das contas a pagar
  avisosEmail Boolean @default(true) @map("avisos_email")
  papel        PapelUsuario   @default(FUNCIONARIO)
  status       StatusRegistro @default(ATIVO)
  criadoEm     DateTime       @default(now()) @map("criado_em")
  atualizadoEm DateTime       @updatedAt @map("atualizado_em")

  pedidos         Pedido[]     @relation("PedidoUsuario")
  pagamentos      Pagamento[]  @relation("PagamentoUsuario")
  itensPreparados PedidoItem[] @relation("PedidoItemPreparadoPor")
  itensCortados   PedidoItem[] @relation("PedidoItemCortadoPor")
  logs            Log[]

  @@map("usuarios")
}

enum TipoCliente {
  PESSOA_FISICA
  EMPRESA
  EVENTO
}

model Cliente {
  id                   String         @id @default(uuid())
  tipo                 TipoCliente
  nome                 String
  razaoSocial          String?        @map("razao_social")
  nomeFantasia         String?        @map("nome_fantasia")
  documento            String? // CPF/CNPJ
  telefone             String?
  whatsapp             String?
  email                String?
  endereco             String?
  limiteCredito        Decimal?       @map("limite_credito") @db.Decimal(12, 2)
  prazoPadraoDias      Int?           @map("prazo_padrao_dias")
  formaPagamentoPadrao String?        @map("forma_pagamento_padrao")
  observacoes          String?
  status               StatusRegistro @default(ATIVO)
  criadoEm             DateTime       @default(now()) @map("criado_em")

  pedidos       Pedido[]
  contasReceber ContaReceber[]

  @@index([documento])
  @@index([nome])
  @@map("clientes")
}

enum TipoVenda {
  PESO
  UNIDADE
  PACOTE_FIXO
}

model CategoriaProduto {
  id       String    @id @default(uuid())
  nome     String
  produtos Produto[]

  @@map("categorias_produtos")
}

model Produto {
  id            String            @id @default(uuid())
  codigo        String            @unique
  nome          String
  categoriaId   String?           @map("categoria_id")
  categoria     CategoriaProduto? @relation(fields: [categoriaId], references: [id])
  tipoVenda     TipoVenda         @default(PESO) @map("tipo_venda")
  unidadeMedida String            @default("kg") @map("unidade_medida")
  preco         Decimal           @db.Decimal(12, 2)
  status        StatusRegistro    @default(ATIVO)
  observacoes   String?

  itens PedidoItem[]

  @@map("produtos")
}

enum StatusPagamentoPedido {
  PENDENTE
  PARCIALMENTE_PAGO
  PAGO
  VENCIDO
  CANCELADO
}

// Fluxo operacional do pedido, separado do status financeiro.
enum StatusOperacaoPedido {
  RECEBIDO
  EM_PREPARO
  EXPEDICAO // legado: não é mais usado (comandas fechadas vão direto para PRONTO)
  PRONTO
  AGUARDANDO_RETIRADA
  EM_ENTREGA
  ENTREGUE
}

enum StatusPreparoItem {
  PENDENTE
  EM_CORTE
  CORTADO
}

enum CanalPedido {
  INTERNO
  PUBLICO
}

enum TipoEntrega {
  RETIRADA
  DELIVERY
}

enum MomentoPagamentoPedido {
  NA_RETIRADA
  NA_ENTREGA
}

model Pedido {
  id                  String                  @id @default(uuid())
  numero              String                  @unique
  clienteId           String?                 @map("cliente_id")
  cliente             Cliente?                @relation(fields: [clienteId], references: [id])
  usuarioId           String?                 @map("usuario_id")
  usuario             Usuario?                @relation("PedidoUsuario", fields: [usuarioId], references: [id])
  canal               CanalPedido             @default(INTERNO)
  tipoEntrega         TipoEntrega             @default(RETIRADA) @map("tipo_entrega")
  momentoPagamento    MomentoPagamentoPedido? @map("momento_pagamento")
  taxaEntrega         Decimal                 @default(0) @map("taxa_entrega") @db.Decimal(12, 2)
  nomeCliente         String?                 @map("nome_cliente")
  telefoneCliente     String?                 @map("telefone_cliente")
  emailCliente        String?                 @map("email_cliente")
  enderecoEntrega     String?                 @map("endereco_entrega")
  observacoesCliente  String?                 @map("observacoes_cliente")
  tokenAcompanhamento String?                 @unique @map("token_acompanhamento")
  subtotal            Decimal                 @db.Decimal(12, 2)
  desconto            Decimal                 @default(0) @db.Decimal(12, 2)
  total               Decimal                 @db.Decimal(12, 2)
  statusPagamento     StatusPagamentoPedido   @default(PENDENTE) @map("status_pagamento")
  statusOperacao      StatusOperacaoPedido    @default(RECEBIDO) @map("status_operacao")
  vencimento          DateTime?
  // Pedido para outro dia (encomenda). Vazio = pedido para o dia em que foi anotado.
  dataAgendada        DateTime?               @map("data_agendada") @db.Date
  criadoEm            DateTime                @default(now()) @map("criado_em")

  itens           PedidoItem[]
  pagamentos      Pagamento[]
  contaReceber    ContaReceber?
  notaFiscal      NotaFiscal?
  statusHistorico PedidoStatusHistorico[]

  @@index([dataAgendada])
  @@map("pedidos")
}

model PedidoItem {
  id             String            @id @default(uuid())
  pedidoId       String            @map("pedido_id")
  pedido         Pedido            @relation(fields: [pedidoId], references: [id])
  produtoId      String            @map("produto_id")
  produto        Produto           @relation(fields: [produtoId], references: [id])
  pesoOuQtd      Decimal           @map("peso_ou_qtd") @db.Decimal(12, 3)
  unidadePedido  String            @default("kg") @map("unidade_pedido")
  observacao     String? // como o cliente quer o corte: "bife fino", "moer 2x", "cubos"
  pesoReal       Decimal?          @map("peso_real") @db.Decimal(12, 3)
  statusPreparo  StatusPreparoItem @default(PENDENTE) @map("status_preparo")
  preparadoPorId String?           @map("preparado_por_id")
  preparadoPor   Usuario?          @relation("PedidoItemPreparadoPor", fields: [preparadoPorId], references: [id])
  cortadoPorId   String?           @map("cortado_por_id")
  cortadoPor     Usuario?          @relation("PedidoItemCortadoPor", fields: [cortadoPorId], references: [id])
  precoUnitario  Decimal           @map("preco_unitario") @db.Decimal(12, 2) // snapshot do preço na venda
  subtotal       Decimal           @db.Decimal(12, 2)

  @@map("pedido_itens")
}

model PedidoStatusHistorico {
  id         String               @id @default(uuid())
  pedidoId   String               @map("pedido_id")
  pedido     Pedido               @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  status     StatusOperacaoPedido
  criadoEm   DateTime             @default(now()) @map("criado_em")
  observacao String?

  @@index([pedidoId, criadoEm])
  @@map("pedido_status_historico")
}

model ConfiguracaoSistema {
  id                          String   @id @default("principal")
  toleranciaPesagemPercentual Decimal  @default(10) @map("tolerancia_pesagem_percentual") @db.Decimal(5, 2)
  criadoEm                    DateTime @default(now()) @map("criado_em")
  atualizadoEm                DateTime @updatedAt @map("atualizado_em")

  @@map("configuracoes_sistema")
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_DEBITO
  CARTAO_CREDITO
  TRANSFERENCIA
  BOLETO
  A_PRAZO
  OUTROS
}

model Pagamento {
  id        String         @id @default(uuid())
  pedidoId  String         @map("pedido_id")
  pedido    Pedido         @relation(fields: [pedidoId], references: [id])
  forma     FormaPagamento
  valor     Decimal        @db.Decimal(12, 2)
  usuarioId String         @map("usuario_id")
  usuario   Usuario        @relation("PagamentoUsuario", fields: [usuarioId], references: [id])
  criadoEm  DateTime       @default(now()) @map("criado_em")

  @@map("pagamentos")
}

enum StatusConta {
  PENDENTE
  PAGO
  VENCIDO
  PARCIAL
  CANCELADO
}

// Contador usado para gerar a numeração sequencial dos pedidos no formato ANO-NNNNNN
// (reinicia a cada ano — já preparado para, no futuro, ter um contador por loja/unidade)
model ContadorPedido {
  id           String @id @default(uuid())
  ano          Int    @unique
  ultimoNumero Int    @default(0)

  @@map("contadores_pedido")
}

model ContaReceber {
  id            String      @id @default(uuid())
  pedidoId      String      @unique @map("pedido_id")
  pedido        Pedido      @relation(fields: [pedidoId], references: [id])
  clienteId     String      @map("cliente_id")
  cliente       Cliente     @relation(fields: [clienteId], references: [id])
  valorOriginal Decimal     @map("valor_original") @db.Decimal(12, 2)
  saldo         Decimal     @db.Decimal(12, 2)
  vencimento    DateTime
  status        StatusConta @default(PENDENTE)

  @@map("contas_receber")
}

model ContaPagar {
  id             String      @id @default(uuid())
  fornecedor     String
  descricao      String
  categoria      String
  valor          Decimal     @db.Decimal(12, 2)
  valorPago      Decimal     @default(0) @map("valor_pago") @db.Decimal(12, 2)
  dataLancamento DateTime    @map("data_lancamento")
  vencimento     DateTime
  dataPagamento  DateTime?   @map("data_pagamento")
  formaPagamento String?     @map("forma_pagamento")
  status         StatusConta @default(PENDENTE)
  observacoes    String?
  // Código de barras / linha digitável do boleto (só números) — evita lançar o mesmo boleto duas vezes
  codigoBarras   String?      @unique @map("codigo_barras")
  // Salário de sábado gerado a partir do cadastro de funcionários
  funcionarioId  String?      @map("funcionario_id")
  funcionario    Funcionario? @relation(fields: [funcionarioId], references: [id], onDelete: SetNull)
  // Salário cheio do sábado (antes dos descontos). valor = salarioBruto − descontos
  salarioBruto   Decimal?     @map("salario_bruto") @db.Decimal(12, 2)
  descontos      DescontoFuncionario[]
  anexos         AnexoConta[]

  @@unique([funcionarioId, vencimento])
  @@map("contas_pagar")
}

// Funcionários da loja. O salário de cada sábado vira uma conta a pagar.
model Funcionario {
  id               String         @id @default(uuid())
  nome             String
  funcao           String?
  telefone         String?
  endereco         String?
  cpf              String?
  rg               String?
  dataNascimento   DateTime?      @map("data_nascimento") @db.Date
  dataAdmissao     DateTime?      @map("data_admissao") @db.Date
  registrado       Boolean        @default(false) // carteira assinada
  salario          Decimal        @db.Decimal(12, 2) // valor pago em cada sábado
  chavePix         String?        @map("chave_pix")
  observacoes      String?
  status           StatusRegistro @default(ATIVO)
  inicioPagamentos DateTime       @map("inicio_pagamentos") @db.Date // primeiro sábado a pagar
  geradoAte        DateTime?      @map("gerado_ate") @db.Date // último sábado já lançado em contas a pagar
  criadoEm         DateTime       @default(now()) @map("criado_em")
  contas           ContaPagar[]
  descontos        DescontoFuncionario[]

  @@map("funcionarios")
}

model NotaFiscal {
  id          String    @id @default(uuid())
  pedidoId    String    @unique @map("pedido_id")
  pedido      Pedido    @relation(fields: [pedidoId], references: [id])
  numero      String?
  serie       String?
  chaveAcesso String?   @map("chave_acesso")
  status      String?
  emitidaEm   DateTime? @map("emitida_em")

  @@map("notas_fiscais")
}

model Log {
  id         String   @id @default(uuid())
  usuarioId  String   @map("usuario_id")
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  acao       String
  entidade   String?
  entidadeId String?  @map("entidade_id")
  detalhes   String?
  criadoEm   DateTime @default(now()) @map("criado_em")

  @@map("logs")
}

// Registro de tentativas para limitar abuso (login errado, pedidos pelo site).
// Fica no banco porque o servidor na Vercel não guarda memória entre requisições.
model TentativaAcesso {
  id       String   @id @default(uuid())
  tipo     String // LOGIN_FALHA_USUARIO | LOGIN_FALHA_IP | PEDIDO_PUBLICO_IP | PEDIDO_PUBLICO_TELEFONE
  chave    String
  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([tipo, chave, criadoEm])
  @@map("tentativas_acesso")
}

// Motoboys de confiança: o WhatsApp da rota abre direto na conversa deles
model Motoboy {
  id       String         @id @default(uuid())
  nome     String
  telefone String
  status   StatusRegistro @default(ATIVO)
  criadoEm DateTime       @default(now()) @map("criado_em")

  @@map("motoboys")
}

// Totais do caixa lançados à mão (vindos do sistema de caixa da loja), um por dia
model LancamentoCaixa {
  id           String   @id @default(uuid())
  data         DateTime @unique @db.Date
  dinheiro     Decimal  @default(0) @db.Decimal(12, 2)
  pix          Decimal  @default(0) @db.Decimal(12, 2)
  cartoes      Decimal  @default(0) @db.Decimal(12, 2)
  // Vendas que vêm do sistema do CEASA
  ceasa        Decimal  @default(0) @db.Decimal(12, 2)
  // Gastos / sangrias tiradas do caixa no dia
  gastos          Decimal @default(0) @db.Decimal(12, 2)
  gastosDescricao String? @map("gastos_descricao")
  observacoes  String?
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("lancamentos_caixa")
}

// Fornecedores usados no dia a dia (puxados ao lançar Contas a Pagar)
model Fornecedor {
  id              String         @id @default(uuid())
  nome            String         @unique
  documento       String? // CNPJ ou CPF
  telefone        String?
  contato         String? // vendedor / pessoa de contato
  categoriaPadrao String         @default("Fornecedores") @map("categoria_padrao")
  observacoes     String?
  status          StatusRegistro @default(ATIVO)
  criadoEm        DateTime       @default(now()) @map("criado_em")

  @@map("fornecedores")
}

enum TipoDescontoFuncionario {
  ADIANTAMENTO
  VALE
  CARNE
  OUTRO
}

/// Adiantamento, vale, carne ou outro desconto do funcionário. É descontado do
/// salário do próximo sábado ainda não pago (se passar do salário, continua no sábado seguinte).
model DescontoFuncionario {
  id            String                  @id @default(uuid())
  funcionarioId String                  @map("funcionario_id")
  funcionario   Funcionario             @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  contaPagarId  String?                 @map("conta_pagar_id")
  contaPagar    ContaPagar?             @relation(fields: [contaPagarId], references: [id], onDelete: SetNull)
  grupoId       String                  @map("grupo_id") // partes do mesmo desconto dividido em vários sábados
  tipo          TipoDescontoFuncionario
  data          DateTime                @db.Date // dia em que o funcionário pegou
  valor         Decimal                 @db.Decimal(12, 2)
  descricao     String?
  criadoPorId   String?                 @map("criado_por_id")
  criadoEm      DateTime                @default(now()) @map("criado_em")

  @@index([funcionarioId, data])
  @@index([contaPagarId])
  @@map("descontos_funcionarios")
}

enum TipoAnexo {
  COMPROVANTE // comprovante do pagamento (boleto pago, Pix...)
  RECIBO_ASSINADO // recibo de salário assinado pelo funcionário
}

/// Arquivo (foto ou PDF) guardado junto de uma conta a pagar.
model AnexoConta {
  id           String     @id @default(uuid())
  contaPagarId String     @map("conta_pagar_id")
  contaPagar   ContaPagar @relation(fields: [contaPagarId], references: [id], onDelete: Cascade)
  tipo         TipoAnexo
  nome         String
  tipoMime     String     @map("tipo_mime")
  tamanho      Int
  dados        Bytes
  criadoPorId  String?    @map("criado_por_id")
  criadoEm     DateTime   @default(now()) @map("criado_em")

  @@index([contaPagarId])
  @@map("anexos_contas")
}
